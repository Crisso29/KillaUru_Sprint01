# Solo NOMBRES de los secretos (RNF-34). El .env real vive en la VM, nunca en el repositorio,
# y tiene una copia cifrada fuera de la VM (runbooks/secretos.md).

# Despliegue
KU_GHCR_CUENTA=
KU_VERSION=

# Base de datos
KU_PG_SUPERUSUARIO=            # solo para migrar.sh --arranque y la imagen de PostgreSQL
KU_DB_MIGRADOR_PASSWORD=
KU_DB_APP_PASSWORD=
KU_DB_HOST=postgres
KU_DB_NOMBRE=killauru

# API
KU_JWT_CLAVE_FIRMA=            # ≥ 32 bytes; se rota al restaurar un respaldo (D9)
KU_CORREO_API_KEY=             # feature 003

# Respaldo en R2 (bucket privado)
KU_R2_ACCESS_KEY_ID=
KU_R2_SECRET_ACCESS_KEY=
KU_R2_ENDPOINT=
KU_R2_BUCKET_RESPALDOS=
KU_BACKUP_CLAVE_PUBLICA=       # clave pública de age; la privada NUNCA está en la VM

# Observabilidad (Grafana Cloud, plan gratuito sin tarjeta)
KU_GRAFANA_OTLP_ENDPOINT=
KU_GRAFANA_OTLP_TOKEN=
KU_GRAFANA_PROM_URL=
KU_GRAFANA_PROM_USUARIO=
KU_GRAFANA_LOKI_URL=
KU_GRAFANA_LOKI_USUARIO=
KU_GRAFANA_API_KEY=

# Túnel de Cloudflare
KU_TUNEL_TOKEN=
