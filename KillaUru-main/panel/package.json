{
  "name": "killauru-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:simulado": "tsc -b && vite build --mode simulado",
    "tipos": "node scripts/generar-tipos.mjs",
    "test": "vitest run",
    "cobertura": "vitest run --coverage",
    "e2e": "playwright test --config playwright.config.ts",
    "e2e:pruebas": "playwright test --config playwright.config.ts --project=chromium-pruebas",
    "lint": "eslint src pruebas --max-warnings=0",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "size": "size-limit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/overpass": "5.1.1",
    "@fontsource/overpass-mono": "5.1.1",
    "@fontsource/source-sans-3": "5.1.1",
    "@tanstack/react-query": "5.56.2",
    "maplibre-gl": "4.7.1",
    "openapi-fetch": "0.12.4",
    "pmtiles": "3.2.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "7.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "9.11.1",
    "@playwright/test": "1.47.2",
    "@size-limit/vite": "11.1.4",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.5.5",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "dependency-cruiser": "16.4.1",
    "eslint": "9.11.1",
    "eslint-plugin-react-hooks": "5.1.0-rc.0",
    "js-yaml": "4.1.0",
    "jsdom": "25.0.0",
    "msw": "2.4.9",
    "openapi-typescript": "7.3.0",
    "size-limit": "11.1.4",
    "typescript": "5.6.2",
    "typescript-eslint": "8.7.0",
    "vite": "5.4.6",
    "vitest": "2.1.1",
    "@vitest/coverage-v8": "2.1.1",
    "vitest-axe": "0.1.0",
    "wrangler": "3.78.7"
  }
}
